#!/bin/bash

if tput setaf 1 >/dev/null 2>&1; then
    Color_Off="$(tput sgr0)"
    Black="$(tput setaf 0)"
    Red="$(tput setaf 1)"
    Green="$(tput setaf 2)"
    Yellow="$(tput setaf 3)"
    Blue="$(tput setaf 4)"
    Purple="$(tput setaf 5)"
    Cyan="$(tput setaf 6)"
    White="$(tput setaf 7)"

    BBlack="$(tput bold; tput setaf 0)"
    BRed="$(tput bold; tput setaf 1)"
    BGreen="$(tput bold; tput setaf 2)"
    BYellow="$(tput bold; tput setaf 3)"
    BBlue="$(tput bold; tput setaf 4)"
    BPurple="$(tput bold; tput setaf 5)"
    BCyan="$(tput bold; tput setaf 6)"
    BWhite="$(tput bold; tput setaf 7)"

    BIBlack="$(tput bold; tput setaf 8)"
    BIRed="$(tput bold; tput setaf 9)"
    BIGreen="$(tput bold; tput setaf 10)"
    BIYellow="$(tput bold; tput setaf 11)"
    BIBlue="$(tput bold; tput setaf 12)"
    BIPurple="$(tput bold; tput setaf 13)"
    BICyan="$(tput bold; tput setaf 14)"
    BIWhite="$(tput bold; tput setaf 15)"
else
    Color_Off="\033[0m"
    Black="\033[0;30m"
    Red="\033[0;31m"
    Green="\033[0;32m"
    Yellow="\033[0;33m"
    Blue="\033[0;34m"
    Purple="\033[0;35m"
    Cyan="\033[0;36m"
    White="\033[0;37m"

    BBlack="\033[1;30m"
    BRed="\033[1;31m"
    BGreen="\033[1;32m"
    BYellow="\033[1;33m"
    BBlue="\033[1;34m"
    BPurple="\033[1;35m"
    BCyan="\033[1;36m"
    BWhite="\033[1;37m"
    
    BIBlack="\033[1;90m"
    BIRed="\033[1;91m"
    BIGreen="\033[1;92m"
    BIYellow="\033[1;93m"
    BIBlue="\033[1;94m"
    BIPurple="\033[1;95m"
    BICyan="\033[1;96m"
    BIWhite="\033[1;97m"
fi

msg() {
    local type="$1"
    local message="$2"
    local color_prefix=""
    local prefix=""

    case "$type" in
        INFO)
            color_prefix="${BCyan}"
            prefix="[INFO]"
            ;;
        SUCCESS)
            color_prefix="${BGreen}"
            prefix="[SUCCESS]"
            ;;
        WARN)
            color_prefix="${BYellow}"
            prefix="[WARN]"
            ;;
        ERROR)
            color_prefix="${BRed}"
            prefix="[ERROR]"
            ;;
        *)
            echo "$message"
            return
            ;;
    esac

    echo -e "${color_prefix}${prefix}${Color_Off} ${message}"
}

check_prereqs() {
    msg INFO "Checking prerequisites..."
    if [ "$EUID" -ne 0 ]; then
        msg ERROR "This script must be run with root privileges (sudo)."
        exit 1
    fi

    if ! command -v pacman &> /dev/null; then
        msg ERROR "Pacman (Arch Linux package manager) not found. Exiting."
        exit 1
    fi
    msg SUCCESS "Prerequisites met. Starting fix process."
}

cleanup_old_config() {
    msg INFO "Cleanup Phase: Checking for and removing potential PulseAudio conflicts."

    if pacman -Qs pulseaudio-bluetooth &> /dev/null; then
        msg WARN "Found 'pulseaudio-bluetooth'. Removing to prevent PipeWire conflict."
        pacman -Rns --noconfirm pulseaudio-bluetooth
    fi
    
    if [ -d "/var/lib/bluetooth" ]; then
        msg WARN "Removing old Bluetooth pairing data from /var/lib/bluetooth to ensure fresh pairing."
        rm -rf /var/lib/bluetooth/*
    fi

    msg SUCCESS "Cleanup phase complete."
}

install_packages() {
    msg INFO "Installing/updating essential packages: BlueZ, PipeWire, and Firmware."

    local packages=(
        "bluez"
        "bluez-utils"
        "bluez-obex"
        "pipewire"
        "pipewire-pulse"
        "wireplumber"
        "blueman"
    )
    
    packages+=("linux-firmware") 

    msg INFO "Running 'pacman -Syu ${packages[*]}'..."
    pacman -Syu --noconfirm "${packages[@]}"
    
    if [ $? -eq 0 ]; then
        msg SUCCESS "All required packages installed successfully."
    else
        msg ERROR "Package installation failed. Check your network or pacman mirrorlist."
        exit 1
    fi
}

manage_bluetooth_service() {
    msg INFO "Managing Bluetooth services."

    msg INFO "Checking RFKill status..."
    rfkill unblock bluetooth
    if rfkill list | grep -q "Soft blocked: yes"; then
        msg WARN "Bluetooth was soft blocked. Unblocked using rfkill."
    else
        msg SUCCESS "Bluetooth is not soft blocked."
    fi

    systemctl enable bluetooth.service
    systemctl start bluetooth.service
    
    if systemctl is-active --quiet bluetooth.service; then
        msg SUCCESS "bluetooth.service is active and enabled."
    else
        msg ERROR "Failed to start bluetooth.service. Check 'journalctl -xeu bluetooth.service'."
    fi
}

configure_pipewire() {
    msg INFO "Ensuring PipeWire and WirePlumber user services are running for audio."

    local user_services=(
        "pipewire.service"
        "pipewire.socket"
        "pipewire-pulse.service"
        "pipewire-pulse.socket"
        "wireplumber.service"
    )

    for service in "${user_services[@]}"; do
        msg INFO "Enabling and starting user service: $service"
        systemctl --user enable "$service"
        systemctl --user start "$service"
    done
    
    msg SUCCESS "PipeWire services are configured for the current user."
    msg INFO "You might need to reboot or log out/in to fully apply all user service changes."
}

main() {
    echo -e "${BBlue}====================================================${Color_Off}"
    echo -e "${BBlue}  Arch/Hyprland Bluetooth Fix Script (PipeWire Focus)${Color_Off}"
    echo -e "${BBlue}====================================================${Color_Off}"

    check_prereqs
    cleanup_old_config
    install_packages
    manage_bluetooth_service
    configure_pipewire

    msg SUCCESS "Bluetooth stack configuration complete."
    echo -e "${BBlue}====================================================${Color_Off}"
    msg WARN "ACTION REQUIRED: Please reboot your system now for all changes to take full effect."
    msg INFO "After rebooting, you can start 'blueman-manager' to connect your devices."
    msg INFO "Alternatively, use 'bluetoothctl' for command-line pairing."
    echo -e "${BBlue}====================================================${Color_Off}"
}

main "$@"
